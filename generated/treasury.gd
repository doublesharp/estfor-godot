# Indexed topics are positional. Supply null for a wildcard or a pre-encoded 32-byte 0x topic.
# Dynamic indexed values must be supplied as their already-computed topic hash.
static func initialized_event_filter(contract_address: String = "", indexed_topics: Array = []) -> Dictionary:
    if indexed_topics.size() > 0:
        return {"ok":false,"error":{"code":"too_many_topics","message":"too many indexed topics for event"}}
    var topics: Array = [INITIALIZED_EVENT_TOPIC]
    for topic in indexed_topics:
        if topic == null:
            topics.append(null)
        elif topic is String and AbiTypegenCodec.is_topic_hex(topic):
            topics.append(topic)
        else:
            return {"ok":false,"error":{"code":"invalid_topic","message":"event topic must be null or a 32-byte 0x hex string"}}
    var filter := {"topics": topics}
    if not contract_address.is_empty():
        if not AbiTypegenCodec.is_address_hex(contract_address):
            return {"ok":false,"error":{"code":"invalid_address","message":"event filter address must be exactly 20 bytes of 0x-prefixed hex"}}
        filter["address"] = contract_address
    return {"ok": true, "value": filter}

